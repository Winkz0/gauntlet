# Copy to config/secrets.env (gitignored). KEY=VALUE, one per line.

# Google Sheet mirror: the ID from the sheet URL, docs.google.com/spreadsheets/d/<ID>/edit
SHEET_ID=

# Your metro for hybrid / unknown-mode checks. Overrides filters.location_context in config.yaml.
LOCATION_CONTEXT=

# General search (config.yaml `search`). Free keys; leave blank to skip a source.
# Adzuna: register at developer.adzuna.com, copy the app id and key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# USAJobs: request a key at developer.usajobs.gov; the email is the one the key was issued to.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Digest email
EMAIL_TO=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app-password-here
SMTP_FROM=you@example.com
